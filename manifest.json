{
  "manifest_version": 3,
  "name": "CellPeek v 2.2",
  "version": "0.2.2",
  "description": "Preview Feishu/Lark sheet cell content in a right side panel.",
  "icons": {
    "16": "icons/cellpeek-icon-16.png",
    "32": "icons/cellpeek-icon-32.png",
    "48": "icons/cellpeek-icon-48.png",
    "128": "icons/cellpeek-icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "scripting", "sidePanel", "clipboardRead", "clipboardWrite", "windows"],
  "host_permissions": [
    "https://feishu.cn/*",
    "https://*.feishu.cn/*",
    "https://larksuite.com/*",
    "https://*.larksuite.com/*",
    "https://*.larkoffice.com/*"
  ],
  "action": {
    "default_title": "Open CellPeek",
    "default_icon": {
      "16": "icons/cellpeek-icon-16.png",
      "32": "icons/cellpeek-icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.feishu.cn/*", "https://feishu.cn/*", "https://*.larksuite.com/*", "https://larksuite.com/*", "https://*.larkoffice.com/*"],
      "js": ["formula-reader.js"],
      "world": "MAIN",
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://feishu.cn/*",
        "https://*.feishu.cn/*",
        "https://larksuite.com/*",
        "https://*.larksuite.com/*",
        "https://*.larkoffice.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
